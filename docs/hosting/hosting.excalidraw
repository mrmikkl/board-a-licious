   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Offline first: the phone works without a connection and syncs its outbox when back online; losing the server loses nothing a phone still holds.\nWho sees what: every row carries the owner's email; the Worker filters by the email from the verified Access token, never by what the phone sends.",
   "originalText": "Offline first: the phone works without a connection and syncs its outbox when back online; losing the server loses nothing a phone still holds.\nWho sees what: every row carries the owner's email; the Worker filters by the email from the verified Access token, never by what the phone sends.",
   "fontSize": 15,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
