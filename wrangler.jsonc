{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "board-a-licious",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  // the postgres driver needs Node's net/tls APIs
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      // Neon project "Board-a-licious" (Frankfurt), direct connection (T077)
      "id": "fe856b6ea9814a788872db3a9ff9ef89",
      "localConnectionString": "postgres://postgres:postgres@localhost:5432/boardalicious"
    }
  ],
  "vars": {
    "ACCESS_TEAM_DOMAIN": "boardalicious.cloudflareaccess.com",
    "ACCESS_AUD": "c59f4fd36f07b0246a4a493e292cccceea6c3eb579fb0437d92db1458f018fa5",
    "ENVIRONMENT": "production"
  }
}
